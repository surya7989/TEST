{
  "name": "at-specialists",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/frontend",
    "build": "npm run build:frontend && node scripts/post-build.js",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:deploy": "node create-deploy-zip.js",
    "deploy:zip": "node create-deploy-zip.js",
    "lint": "npm run lint --workspace=apps/frontend"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.1",
    "@rollup/rollup-linux-x64-musl": "4.63.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
