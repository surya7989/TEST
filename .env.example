# ==============================================================================
# AT SPECIALISTS AUSTRALIA - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in production and fill in the real values.
# NEVER commit the real .env file with actual credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hostinger MySQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_atspec
DB_PASSWORD=your_secure_mysql_database_password_here
DB_NAME=u123456789_atspecialists

# ------------------------------------------------------------------------------
# 2. JWT Secret (Generate a strong 64-character random string)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars

# ------------------------------------------------------------------------------
# 3. SMTP Mail Server Configuration (Hostinger / Google Workspace / SendGrid)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@atspecialists.com.au
SMTP_PASS=your_secure_smtp_app_password_here
SMTP_FROM_NAME=AT Specialists Australia
SMTP_FROM_EMAIL=admin@atspecialists.com.au
ADMIN_NOTIFICATION_EMAIL=admin@atspecialists.com.au

# ------------------------------------------------------------------------------
# 4. PayPal REST API Credentials (Developer Dashboard -> Apps & Credentials)
# ------------------------------------------------------------------------------
# For production: set PAYPAL_MODE=live and use Live Client ID and Secret
# For testing: set PAYPAL_MODE=sandbox and use Sandbox Client ID and Secret
PAYPAL_MODE=sandbox
# PUBLIC Client ID (Safe for frontend):
VITE_PAYPAL_CLIENT_ID=your_public_paypal_client_id_here
PAYPAL_CLIENT_ID=your_public_paypal_client_id_here
# PRIVATE Secret Key (SERVER ONLY - NEVER expose to browser):
PAYPAL_SECRET=your_private_paypal_secret_key_here
CURRENCY=AUD

# ------------------------------------------------------------------------------
# 5. Firebase Configuration (Project: at-specialist)
# ------------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID=at-specialist
VITE_FIREBASE_AUTH_DOMAIN=at-specialist.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=at-specialist.appspot.com
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here

# ------------------------------------------------------------------------------
# 6. Application URLs
# ------------------------------------------------------------------------------
CLIENT_URL=https://new.atspecialists.com.au
VITE_API_URL=https://new.atspecialists.com.au
PORT=4000

